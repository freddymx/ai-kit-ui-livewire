{
    "name": "solution-forest/ai-kit-ui-livewire",
    "description": "Livewire 4 chat UI for ai-kit: streaming RAG responses, markdown rendering, and source citations. No build step required.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "ai", "rag", "chat"],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^4.4",
        "league/commonmark": "^2.4",
        "solution-forest/ai-kit-core": "^0.3"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\AiKit\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\AiKit\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "laravel": {
            "providers": [
                "SolutionForest\\AiKit\\Ui\\AiKitUiServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ai-kit-core",
            "options": { "symlink": true }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
